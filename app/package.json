{
  "name": "home-expense-frontend-new",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs",
    "lint": "pnpm lint:biome && pnpm lint:stylelint && pnpm typecheck",
    "lint:biome": "biome check .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "fix": "pnpm fix:biome && pnpm fix:stylelint",
    "fix:biome": "biome check --write .",
    "fix:stylelint": "stylelint \"src/**/*.css\" --fix"
  },
  "dependencies": {
    "@home-expense/ui": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "7.0.2"
  }
}
