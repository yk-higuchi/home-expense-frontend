{
  "name": "@home-expense/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:biome && pnpm lint:stylelint && pnpm typecheck",
    "lint:biome": "biome check .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "fix": "pnpm fix:biome && pnpm fix:stylelint",
    "fix:biome": "biome check --write .",
    "fix:stylelint": "stylelint \"src/**/*.css\" --fix"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@storybook/addon-designs": "12.0.0",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
