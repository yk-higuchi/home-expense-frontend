          "ホバー": ":hover",
          "押下": ":active",
          "フォーカス": ":focus-visible"
        }
      }
    },
    "サイドバー": {
      "code": ["SideBar"],
      "source": ["app/src/ui/parts/app-side-bar.tsx"]
