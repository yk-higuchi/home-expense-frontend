          "ホバー": ":hover",
          "押下": ":active",
          "フォーカス": ":focus-visible"
        },
        "端末": {
          "マウス": "通常",
          "タッチ": "@media (pointer: coarse)（SideBar の項目を最小の高さ 44px にする）"
        }
      }
    },
    "サイドバー": {
      "code": ["SideBar"],
      "source": ["app/src/ui/parts/app-side-bar.tsx"]
    },
    "ナビバー": {
      "code": ["NavBar"],
      "source": ["app/src/ui/parts/site-menu.tsx"]
    },
    "プルダウン": {
      "code": ["Select"],
      "variants": {
        "サイズ": {
          "大": "label なし（期間の選択。period-filter-frame.tsx）",
          "標準": "label あり（フォーム）"
        },
        "状態": {
          "通常": "既定",
          "ホバー": ":hover",
          "フォーカス": ":focus-visible",
          "エラー": "errorMessage",
          "エラー（フォーカス）": "errorMessage と :focus-visible",
          "無効": "disabled",
          "読み込み中": "skeleton"
        }
      }
    },
