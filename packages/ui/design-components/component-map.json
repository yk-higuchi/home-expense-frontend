      "code": ["Calendar"],
      "variants": {
        "今月": { "いいえ": "既定", "はい": "data-today" },
        "状態": {
          "通常": "既定",
          "ホバー": ":hover",
          "押下": ":active",
          "選択中": "data-selected",
          "フォーカス": ":focus-visible",
          "無効": "data-disabled"
